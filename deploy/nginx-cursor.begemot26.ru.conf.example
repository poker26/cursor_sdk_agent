# Пример для Debian: /etc/nginx/sites-available/cursor.begemot26.ru
# Прокси на локальный cursor-sdk-agent (PM2, PORT=3847).
#
# После копирования:
#   sudo ln -s /etc/nginx/sites-available/cursor.begemot26.ru /etc/nginx/sites-enabled/
#   sudo nginx -t
#   sudo systemctl reload nginx
#   sudo certbot --nginx -d cursor.begemot26.ru

server {
    listen 80;
    listen [::]:80;
    server_name cursor.begemot26.ru;

    location / {
        proxy_pass http://127.0.0.1:3847;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE / долгие ответы агента
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# Certbot добавит блок listen 443 ssl и редирект с HTTP на HTTPS.
