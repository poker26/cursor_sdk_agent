# Файл подхватывается при старте (dotenv). Не коммитьте в git.
CURSOR_API_KEY=cursor_...
AGENT_CWD=/path/to/git/repo/on/server

# Несколько репозиториев (в UI — выпадающий список). Если задано — AGENT_CWD не обязателен.
# AGENT_WORKSPACES_JSON={"main":"/var/www/project-a","tools":"/var/www/project-b"}

# Лимит вложения в байтах (по умолчанию 3 МБ)
# UPLOAD_MAX_BYTES=3145728

# Модель по умолчанию (локальный агент — поле обязательно в SDK)
CURSOR_MODEL_ID=composer-2
# Список моделей в UI: backend всегда берёт только доступные у Cursor API key.
# Эти переменные работают как дополнительный whitelist/переименование label:
# CURSOR_MODEL_IDS=composer-2,composer-2-fast,composer-2.5-fast,gpt-5.3-codex
# CURSOR_MODELS_JSON=[{"id":"composer-2","label":"Composer 2"},{"id":"gpt-5.3-codex","label":"GPT-5.3 Codex"}]

# Опционально: Atlassian MCP по внутреннему URL (слэш в конце пути /mcp/ как у вашего сервера)
ATLASSIAN_MCP_URL=http://10.0.0.5:8002/mcp/
ATLASSIAN_MCP_API_KEY=...

# Опционально: GitLab MCP (HTTP, заголовок X-API-Key — как в README gitlab-mcp)
# GITLAB_MCP_URL=http://10.0.0.6:8901/mcp
# GITLAB_MCP_API_KEY=...

# Опционально: Minio MCP по HTTP (если ваш сервер ожидает X-API-Key; иначе см. MCP_EXTRA_JSON)
# MINIO_MCP_URL=http://10.0.0.7:9005/mcp
# MINIO_MCP_API_KEY=...

# Exchange / корпоративная почта (HTTP MCP, X-API-Key — как в ~/.cursor/mcp.json)
# С VDS агента используйте внутренний IP, не публичный. Слэш в конце /mcp/ — как у сервера.
# EXCHANGE_MCP_URL=http://10.16.0.3:8903/mcp/
# EXCHANGE_MCP_API_KEY=...

# Notion: личные заметки (stdio MCP, официальный @notionhq/notion-mcp-server)
# Токен: https://www.notion.so/profile/integrations → Internal Integration Secret (ntn_...)
# Дайте integration доступ к нужным страницам/базам (Access в настройках integration).
# NOTION_TOKEN=ntn_...
# NOTION_MCP_NPX_PATH=/root/.nvm/versions/node/v22.22.0/bin/npx

# Historical recipes (Flora MCP, ключ опционален — как в ~/.cursor/mcp.json)
# HISTORICAL_RECIPES_MCP_URL=https://flora.begemot26.ru/mcp
# HISTORICAL_RECIPES_MCP_API_KEY=

# Опционально: любые другие MCP (stdio, Bearer, нестандартный путь). Объект как в Cursor / SDK.
# Ключи сливаются с блоками выше; при одинаковом имени побеждает запись из JSON.
# MCP_EXTRA_JSON={"custom":{"type":"stdio","command":"node","args":["/opt/mcp/dist/index.js"],"env":{"FOO":"bar"}}}

# Порт HTTP сервиса
PORT=3847

# PM2 на VDS (имя процесса):
# pm2 restart cursor-sdk-agent

# Якорь «сегодня / завтра / понедельник» в каждом сообщении чата
# AGENT_TIMEZONE=Europe/Moscow

# Через сколько мс бездействия уничтожать агента workspace (по умолчанию 30 мин)
# SESSION_IDLE_DISPOSE_MS=1800000

# Фаза 1: memory.md в {AGENT_CWD}/.cursor-agent/
# MEMORY_ENABLED=true
# MEMORY_MAX_CHARS=32000
# PERSIST_AGENT_ID=true

# Фаза 2: Supabase (применить supabase/migrations/001_brain_schema.sql)
# SUPABASE_URL=https://...
# SUPABASE_SERVICE_KEY=...

# Фаза 3: Qdrant + BGE-M3 (достаточно двух строк ниже)
# QDRANT_URL=http://sup.begemot26.ru:6333
# BGE_M3_URL=https://46.173.25.31
# BGE_M3_PORT=8100
# QDRANT_API_KEY=...
# QDRANT_TOP_K=6
# EMBEDDING_DIMENSIONS=1024
# Альтернатива: OpenAI-compatible embedder
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=...

# Фаза 4: ingest (npm run brain:ingest)
# BRAIN_JIRA_PP_KEY=PP
# BRAIN_JIRA_FF_KEY=FF
# BRAIN_CONFLUENCE_PP_SPACE=PP

# Индикатор VPN в UI (проверка Atlassian MCP health через VPN)
# VPN_HEALTH_URL=http://10.16.0.1:8002/health
# VPN_HEALTH_TIMEOUT_MS=5000
# VPN_HEALTH_POLL_MS=20000

# Фаза 5: голос (Yandex SpeechKit) — см. docs/plans/phase5-voice-yandex.md
# VOICE_ENABLED=true
# YANDEX_API_KEY=...
# YANDEX_FOLDER_ID=b1g...
# YANDEX_STT_LANG=ru-RU
# YANDEX_STT_FORMAT=oggopus
# YANDEX_TTS_VOICE=alena
# YANDEX_TTS_LANG=ru-RU
# YANDEX_TTS_FORMAT=oggopus
# VOICE_AUTO_SEND=true
# VOICE_MAX_AUDIO_BYTES=5242880
# VOICE_MAX_TTS_CHARS=4500
# Короткие фразы при ошибке голосового запроса (полный текст — только в чате / логе)
# VOICE_ERROR_SPEECH_BRIEF=Не удалось выполнить запрос. Подробности в чате.
# VOICE_ERROR_SPEECH_BUSY=Подождите, агент занят. Повторите через минуту.
# Диагностика run error: conversation() после wait() по умолчанию выключена (может ломать агента)
# RUN_DIAGNOSTICS_USE_CONVERSATION=true
# Для WebM с Chrome на VDS нужен ffmpeg: apt install ffmpeg

# Фаза 7: переезды между встречами (Яндекс Geocoder + Router) — docs/plans/phase7-calendar-travel-yandex-maps.md
# TRAVEL_ENABLED=true
# YANDEX_MAPS_API_KEY=...          # отдельный ключ Карт (не SpeechKit)
# TRAVEL_ROUTE_MODE=driving          # driving | transit | walking | bicycle
# TRAVEL_BUFFER_WORK_MINUTES=10
# TRAVEL_BUFFER_SPORT_MINUTES=15     # после тренировки (переодевание, выход)
# TRAVEL_GEOCODER_LANG=ru_RU

# Фаза 8: мониторинг Jira-эпиков → Telegram (команда в чате «Поставь <url> на мониторинг»)
# Бот: @BotFather → /newbot → токен; chat id: напишите боту и возьмите из getUpdates,
# или для группы добавьте бота и используйте отрицательный id чата.
# TELEGRAM_BOT_TOKEN=123456:AA...
# TELEGRAM_CHAT_ID=123456789
# Тик планировщика (мс): как часто gateway проверяет, какие эпики «созрели» (по умолчанию 60 с)
# MONITOR_TICK_MS=60000
# Интервал по умолчанию для новых эпиков, если в команде не указан (по умолчанию 30 мин)
# MONITOR_POLL_INTERVAL_MS=1800000
# База Jira для ссылок в уведомлениях (по умолчанию https://jira.inplatlabs.ru)
# JIRA_BASE_URL=https://jira.inplatlabs.ru
# Требует Supabase (миграции 002 + 003) и Atlassian MCP.
# В чате: «…на мониторинг раз в 30 мин» / «раз в сутки»; «измени интервал MNT-14980 на раз в сутки»

# Изолированный инстанс (напр. flora — только historical-recipes): см. .env.flora.example
# Свой стартовый промпт памяти и голосовой стиль (по умолчанию — рабочие, зашитые в коде):
# MEMORY_BOOTSTRAP_PATH=prompts/flora/memory-bootstrap.md
# CHAT_VOICE_STYLE_PATH=prompts/flora/voice-style.md
# UI-флаги (по умолчанию true): скрыть VPN-индикатор и кнопку прикрепления файла
# UI_SHOW_VPN_INDICATOR=false
# UI_ALLOW_ATTACHMENTS=false

# Опционально: Basic Auth на весь сайт кроме /health
# CHAT_BASIC_USER=you
# CHAT_BASIC_PASSWORD=long-random-secret
