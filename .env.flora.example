# ── Изолированный тестовый инстанс «flora» ──────────────────────────────
# Только MCP historical-recipes. БЕЗ рабочих MCP, Supabase, Qdrant, Telegram, VPN, авторизации.
# Скопируйте в .env на сервере flora-инстанса.

# Доступ к моделям Cursor (можно тот же ключ, что и на рабочем — это лишь доступ к LLM, не к данным)
CURSOR_API_KEY=cursor_...
CURSOR_MODEL_ID=composer-2

# Отдельный ИЗОЛИРОВАННЫЙ рабочий каталог (здесь будет своя чистая memory.md в .cursor-agent/)
# НЕ указывайте сюда рабочий репозиторий.
AGENT_CWD=/root/flora-agent-workspace

# Свой порт (чтобы не конфликтовать с рабочим инстансом, если на том же VDS)
PORT=3850

# Единственный подключённый MCP
HISTORICAL_RECIPES_MCP_URL=https://flora.begemot26.ru/mcp
# HISTORICAL_RECIPES_MCP_API_KEY=

# Flora-промпты (пути относительно корня репозитория = рабочей директории pm2; можно абсолютные)
MEMORY_BOOTSTRAP_PATH=prompts/flora/memory-bootstrap.md
CHAT_VOICE_STYLE_PATH=prompts/flora/voice-style.md

# Чистый UI: без VPN-индикатора и без прикрепления файлов
UI_SHOW_VPN_INDICATOR=false
UI_ALLOW_ATTACHMENTS=false
UI_FAVICON_PRESET=flora
UI_PAGE_TITLE=Flora · Recipes
UI_THEME_COLOR=#14301a

# Голос — по тем же правилам (вход голос → краткий выход; вход текст → полный текст)
VOICE_ENABLED=true
YANDEX_API_KEY=...
YANDEX_FOLDER_ID=b1g...
# Для WebM (Chrome) нужен ffmpeg на сервере: apt install ffmpeg

# ── НЕ задавайте на flora (иначе подключится рабочая инфраструктура): ──
# ATLASSIAN_MCP_URL / GITLAB_MCP_URL / MINIO_MCP_URL / EXCHANGE_MCP_URL / NOTION_TOKEN
# SUPABASE_URL / SUPABASE_SERVICE_KEY / QDRANT_URL / BGE_M3_URL
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID
# VPN_HEALTH_URL
# CHAT_BASIC_USER / CHAT_BASIC_PASSWORD  (авторизация не нужна)
